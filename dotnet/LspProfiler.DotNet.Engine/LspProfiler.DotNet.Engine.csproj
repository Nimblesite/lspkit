<Project Sdk="Microsoft.NET.Sdk">
  <!-- The out-of-process .NET profiling engine driven by the lsp-profiler-dotnet crate.
       Implements [PROF-DOTNET-ENGINE]. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>lsp-profiler-dotnet-engine</AssemblyName>
    <RootNamespace>LspProfiler.DotNet.Engine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.745401" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LspProfiler.DotNet.Engine.Tests" />
  </ItemGroup>
</Project>
