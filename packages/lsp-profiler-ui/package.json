{
  "name": "@nimblesite/lsp-profiler-ui",
  "version": "0.0.1",
  "description": "Editor-neutral VS Code UI for the lsp-profiler protocol: processes view, CPU heat map, flame graph, memory dashboard, retention graph, autopilot.",
  "license": "MIT",
  "repository": "https://github.com/Nimblesite/lspkit",
  "main": "./out/src/index.js",
  "types": "./out/src/index.d.ts",
  "files": [
    "out/src",
    "!out/src/test",
    "scripts/contributions.mjs"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "lint": "eslint src/",
    "test": "vscode-test",
    "test:paths": "mocha --ui tdd out/src/test/suite/editor-path-key.test.js"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4"
  },
  "peerDependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "overrides": {
    "mocha": "$mocha"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.0.0",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
