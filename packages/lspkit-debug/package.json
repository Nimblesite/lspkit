{
  "name": "@nimblesite/lspkit-debug",
  "version": "0.0.1",
  "description": "Language-neutral VS Code Debug Adapter Protocol (DAP) glue and test harness for LspKit-based editors. Shared by every Nimblesite language extension so the debugger plumbing is written once, not per language.",
  "license": "MIT",
  "author": "Nimblesite",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimblesite/lspkit.git",
    "directory": "packages/lspkit-debug"
  },
  "keywords": [
    "dap",
    "debug-adapter-protocol",
    "vscode",
    "debugger",
    "lsp",
    "lspkit"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "c8 mocha",
    "test:only": "mocha",
    "clean": "rm -rf dist out coverage .nyc_output"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "c8": "^9.1.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
