{# [WEB-CONTENT-JOURNAL] An illustrated entry into the actual blog posts. #}
<div class="blog-container journal-index">
  <header class="blog-header">
    <p class="eyebrow">The lspkit journal</p>
    <h1>Notes from the workbench.</h1>
    <p class="blog-subtitle">Ideas, decisions and working notes on building better developer tools.</p>
  </header>
  {% include "header-image.njk" %}
  <section class="journal-posts" aria-label="Journal posts">
    {% for post in collections.posts | reverse %}
    <article class="journal-entry">
      <p class="eyebrow"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateFormat }}</time> / {{ post.data.author }}</p>
      <div>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p>{{ post.data.excerpt }}</p>
        <a class="text-link" href="{{ post.url }}">Read the story <span aria-hidden="true">↗</span></a>
      </div>
    </article>
    {% endfor %}
  </section>
</div>
